PORT=5000

# Admin PostgreSQL Database Configuration
ADMIN_DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/fleetsphere_admin

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long
JWT_EXPIRES_IN=1h
JWT_ISSUER=fleetsphere-api
JWT_AUDIENCE=fleetsphere-client

# Tenant Database Credentials & Defaults
TENANT_DB_DEFAULT_HOST=localhost
TENANT_DB_DEFAULT_PORT=5432
TENANT_DB_DEFAULT_USER=postgres
TENANT_DB_DEFAULT_PASSWORD=your_postgres_password

# Client-specific secret overrides (keyed by c_secret_reference in tbl_tenant_database_config)
TENANT_SECRET_CLIENTA_USER=postgres
TENANT_SECRET_CLIENTA_PASSWORD=your_postgres_password
TENANT_SECRET_CLIENTB_USER=postgres
TENANT_SECRET_CLIENTB_PASSWORD=your_postgres_password

# CORS Configuration
CORS_ORIGIN=http://localhost:4200






-- Run inside fleetsphere_client001_db

CREATE TABLE IF NOT EXISTS public.tbl_designation_mst (
    u_designation_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    c_designation_code VARCHAR(50) NOT NULL UNIQUE,
    c_designation_name VARCHAR(100) NOT NULL,
    b_is_active BOOLEAN NOT NULL DEFAULT TRUE,
    d_created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS public.tbl_employee_mst (
    u_employee_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    c_employee_code VARCHAR(50) NOT NULL UNIQUE,
    c_first_name VARCHAR(100) NOT NULL,
    c_last_name VARCHAR(100),
    c_email VARCHAR(255),
    u_designation_id UUID REFERENCES public.tbl_designation_mst(u_designation_id),
    d_joining_date DATE,
    b_is_active BOOLEAN NOT NULL DEFAULT TRUE,
    d_created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS public.tbl_user_mst (
    u_user_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    u_employee_id UUID REFERENCES public.tbl_employee_mst(u_employee_id),
    c_email VARCHAR(255) NOT NULL,
    c_password_hash VARCHAR(255) NOT NULL,
    c_user_status VARCHAR(20) NOT NULL DEFAULT 'ACTIVE'
        CHECK (c_user_status IN ('ACTIVE', 'LOCKED', 'DISABLED')),
    d_last_login_at TIMESTAMPTZ,
    b_is_active BOOLEAN NOT NULL DEFAULT TRUE,
    d_created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE UNIQUE INDEX IF NOT EXISTS uq_user_email_lower
    ON public.tbl_user_mst (LOWER(c_email));

CREATE TABLE IF NOT EXISTS public.tbl_role_mst (
    u_role_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    c_role_code VARCHAR(50) NOT NULL UNIQUE,
    c_role_name VARCHAR(100) NOT NULL,
    c_description VARCHAR(255),
    b_is_system_role BOOLEAN NOT NULL DEFAULT FALSE,
    b_is_active BOOLEAN NOT NULL DEFAULT TRUE,
    d_created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS public.tbl_permission_mst (
    u_permission_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    c_permission_code VARCHAR(100) NOT NULL UNIQUE,
    c_permission_name VARCHAR(150) NOT NULL,
    c_module_code VARCHAR(50) NOT NULL,
    b_is_active BOOLEAN NOT NULL DEFAULT TRUE,
    d_created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS public.tbl_user_role_map (
    u_user_role_map_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    u_user_id UUID NOT NULL REFERENCES public.tbl_user_mst(u_user_id),
    u_role_id UUID NOT NULL REFERENCES public.tbl_role_mst(u_role_id),
    b_is_active BOOLEAN NOT NULL DEFAULT TRUE,
    d_created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (u_user_id, u_role_id)
);

CREATE TABLE IF NOT EXISTS public.tbl_role_permission_map (
    u_role_permission_map_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    u_role_id UUID NOT NULL REFERENCES public.tbl_role_mst(u_role_id),
    u_permission_id UUID NOT NULL
        REFERENCES public.tbl_permission_mst(u_permission_id),
    b_is_active BOOLEAN NOT NULL DEFAULT TRUE,
    d_created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    UNIQUE (u_role_id, u_permission_id)
);

CREATE INDEX IF NOT EXISTS idx_user_role_user
    ON public.tbl_user_role_map(u_user_id);

CREATE INDEX IF NOT EXISTS idx_role_permission_role
    ON public.tbl_role_permission_map(u_role_id);




BEGIN;

-- 1. Create the Client Admin role
INSERT INTO public.tbl_role_mst (
    c_role_code,
    c_role_name,
    c_description,
    b_is_system_role
)
VALUES (
    'ADMIN',
    'Administrator',
    'Manages users, employees, roles, designations and client settings',
    TRUE
)
ON CONFLICT (c_role_code) DO NOTHING;

-- 2. Insert permissions
INSERT INTO public.tbl_permission_mst (
    c_permission_code,
    c_permission_name,
    c_module_code
)
VALUES
    ('employee.view',       'View Employees',           'EMPLOYEE'),
    ('employee.create',     'Create Employees',         'EMPLOYEE'),
    ('employee.update',     'Update Employees',         'EMPLOYEE'),
    ('employee.deactivate', 'Deactivate Employees',     'EMPLOYEE'),

    ('user.view',           'View Users',               'USER'),
    ('user.create',         'Create Users',             'USER'),
    ('user.update',         'Update Users',             'USER'),
    ('user.reset_password', 'Reset User Passwords',    'USER'),
    ('user.deactivate',     'Deactivate Users',         'USER'),

    ('role.view',           'View Roles',               'ROLE'),
    ('role.create',         'Create Roles',             'ROLE'),
    ('role.update',         'Update Roles',             'ROLE'),
    ('role.assign_permissions', 'Assign Permissions',   'ROLE'),

    ('designation.manage',  'Manage Designations',      'DESIGNATION'),
    ('organization.manage', 'Manage Organization',      'ORGANIZATION'),
    ('dashboard.manage',    'Manage Dashboard Settings', 'DASHBOARD'),
    ('masters.manage',      'Manage Client Masters',    'MASTER')
ON CONFLICT (c_permission_code) DO NOTHING;

-- 3. Assign the seeded permissions to CLIENT_ADMIN
INSERT INTO public.tbl_role_permission_map (
    u_role_id,
    u_permission_id
)
SELECT
    r.u_role_id,
    p.u_permission_id
FROM public.tbl_role_mst r
CROSS JOIN public.tbl_permission_mst p
WHERE r.c_role_code = 'ADMIN'
  AND p.c_permission_code IN (
      'employee.view',
      'employee.create',
      'employee.update',
      'employee.deactivate',
      'user.view',
      'user.create',
      'user.update',
      'user.reset_password',
      'user.deactivate',
      'role.view',
      'role.create',
      'role.update',
      'role.assign_permissions',
      'designation.manage',
      'organization.manage',
      'dashboard.manage',
      'masters.manage'
  )
ON CONFLICT (u_role_id, u_permission_id) DO NOTHING;

COMMIT;




INSERT INTO public.tbl_designation_mst (
    c_designation_code,
    c_designation_name
)
VALUES (
    'ADMIN',
    'Client Administrator'
)
ON CONFLICT (c_designation_code) DO NOTHING;




INSERT INTO public.tbl_employee_mst (
    c_employee_code,
    c_first_name,
    c_last_name,
    c_email,
    u_designation_id
)
SELECT
    'ADM001',
    'Client',
    'Administrator',
    'admin@client001.com',
    d.u_designation_id
FROM public.tbl_designation_mst d
WHERE d.c_designation_code = 'ADMIN'
  AND NOT EXISTS (
      SELECT 1
      FROM public.tbl_employee_mst e
      WHERE e.c_employee_code = 'ADM001'
  );



INSERT INTO public.tbl_user_mst (
    u_employee_id,
    c_email,
    c_password_hash
)
SELECT
    e.u_employee_id,
    'admin@client001.com',
    'PASTE_BCRYPT_HASH_HERE'
FROM public.tbl_employee_mst e
WHERE e.c_employee_code = 'ADM001'
  AND NOT EXISTS (
      SELECT 1
      FROM public.tbl_user_mst u
      WHERE LOWER(u.c_email) = LOWER('admin@client001.com')
  );




  INSERT INTO public.tbl_user_role_map (
    u_user_id,
    u_role_id
)
SELECT
    u.u_user_id,
    r.u_role_id
FROM public.tbl_user_mst u
CROSS JOIN public.tbl_role_mst r
WHERE LOWER(u.c_email) = LOWER('admin@client001.com')
  AND r.c_role_code = 'ADMIN'
ON CONFLICT (u_user_id, u_role_id) DO NOTHING;





BEGIN;

-- 1. Add the client company
INSERT INTO public.tbl_company_master (
    c_company_code,
    c_company_name,
    c_status
)
VALUES (
    'CLIENTA',
    'First Client Company',
    'active'
)
ON CONFLICT (c_company_code) DO NOTHING;

-- 2. Add the subscription plan
INSERT INTO public.tbl_subscription_plans (
    c_plan_code,
    c_plan_name,
    n_max_users
)
VALUES (
    'STARTER',
    'Starter Plan',
    50
)
ON CONFLICT (c_plan_code) DO NOTHING;

-- 3. Configure the client's tenant database
INSERT INTO public.tbl_tenant_database_config (
    u_company_id,
    c_database_name,
    c_database_host,
    n_database_port,
    c_ssl_mode,
    c_secret_reference,
    c_provisioning_status
)
SELECT
    u_company_id,
    'fleetsphere_clientA',
    'localhost',
    5432,
    'disable',
    'CLIENTA',
    'ready'
FROM public.tbl_company_master
WHERE c_company_code = 'CLIENTA'
ON CONFLICT (u_company_id) DO NOTHING;

-- 4. Add a subscription for the client
INSERT INTO public.tbl_tenant_subscriptions (
    u_company_id,
    u_plan_id,
    d_start_date,
    d_end_date,
    c_subscription_status
)
SELECT
    cm.u_company_id,
    sp.u_plan_id,
    CURRENT_DATE,
    CURRENT_DATE + 30,
    'trial'
FROM public.tbl_company_master cm
CROSS JOIN public.tbl_subscription_plans sp
WHERE cm.c_company_code = 'CLIENTA'
  AND sp.c_plan_code = 'STARTER'
  AND NOT EXISTS (
      SELECT 1
      FROM public.tbl_tenant_subscriptions ts
      WHERE ts.u_company_id = cm.u_company_id
        AND ts.c_subscription_status IN ('trial', 'active')
  );

COMMIT;

